{
  "manifest_version": 3,
  "name": "SmoothBoost: Web Lag & Animation Killer",
  "short_name": "SmoothBoost",
  "version": "2.2.0",
  "description": "Intelligent web performance optimizer: eliminates lag, throttles background canvas & media, and accelerates scrolling.",
  "browser_specific_settings": {
    "gecko": {
      "id": "smoothboost@binifn.github.io",
      "strict_min_version": "109.0"
    },
    "gecko_android": {
      "strict_min_version": "120.0"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmoothBoost Performance Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/site-rules.json",
        "scripts/compat.js",
        "scripts/page-hook.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "scripts": [
      "scripts/compat.js",
      "scripts/background.js"
    ]
  },
  "commands": {
    "toggle-speed-boost": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Toggle SmoothBoost on current website"
    }
  }
}
