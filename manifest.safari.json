{
  "manifest_version": 3,
  "name": "SmoothBoost",
  "version": "2.4.0",
  "description": "Hardware-composited scrolling and background work optimization for Safari.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "SmoothBoost"
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "scripts/compat.js",
        "scripts/content.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "scripts/compat.js",
        "scripts/page-hook.js",
        "data/site-rules.json"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ]
}
