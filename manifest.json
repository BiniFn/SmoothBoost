{
  "manifest_version": 3,
  "name": "SmoothBoost: Web Performance Optimizer",
  "short_name": "SmoothBoost",
  "version": "2.5.0",
  "description": "Web performance booster with Scroll Boost v2, Shadow DOM boost, Smart Resource Loading, Memory Guard, and Dynamic FPS profiles.",
  "homepage_url": "https://github.com/BiniFn/SmoothBoost",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "SmoothBoost Performance Controller",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "alarms",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/site-rules.json",
        "scripts/compat.js",
        "scripts/page-hook.js"
      ],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "scripts/background.js"
  },
  "commands": {
    "toggle-speed-boost": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Toggle SmoothBoost on current website"
    }
  }
}
