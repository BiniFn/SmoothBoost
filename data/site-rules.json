{
  "version": 3,
  "packName": "SmoothBoost Universal Community Rules",
  "updatedAt": "2026-11-26",
  "genericCarouselSelectors": [
    ".swiper",
    "[data-swiper]",
    ".slick-slider",
    ".splide",
    ".embla",
    ".flickity-enabled"
  ],
  "siteRules": [
    {
      "id": "reanime-home-hero",
      "hosts": ["reanime.to"],
      "paths": ["/", "/home"],
      "heroSelectors": [
        "[aria-label=\"Hero carousel\"]",
        "[aria-label*=\"hero carousel\" i]",
        "[data-testid*=\"hero-carousel\" i]"
      ],
      "behavior": "pause-autoplay-preserve-manual-controls"
    },
    {
      "id": "youtube-feed-optimizer",
      "hosts": ["youtube.com", "m.youtube.com"],
      "paths": ["/*"],
      "behavior": "defer-offscreen-comments-and-ambient",
      "deferSelectors": [
        "#comments",
        "ytd-comments",
        "#related",
        "ytd-watch-next-secondary-results-renderer",
        "ytd-rich-item-renderer",
        "ytd-compact-video-renderer"
      ]
    },
    {
      "id": "reddit-feed-optimizer",
      "hosts": ["reddit.com", "www.reddit.com", "old.reddit.com"],
      "paths": ["/*"],
      "behavior": "pause-offscreen-media-and-embeds",
      "deferSelectors": [
        "shreddit-async-loader",
        "shreddit-post",
        "shreddit-comment",
        "[data-testid=\"post-container\"]",
        "[data-testid=\"post-container\"] iframe"
      ]
    },
    {
      "id": "twitter-x-optimizer",
      "hosts": ["x.com", "twitter.com"],
      "paths": ["/*"],
      "behavior": "spa-feed-content-visibility",
      "feedSelectors": [
        "[data-testid=\"primaryColumn\"] section",
        "[data-testid=\"cellInnerDiv\"]",
        "div[aria-label=\"Timeline: Your Home Timeline\"] > div"
      ]
    },
    {
      "id": "twitch-kick-optimizer",
      "hosts": ["twitch.tv", "kick.com"],
      "paths": ["/*"],
      "behavior": "defer-offscreen-comments-and-ambient",
      "deferSelectors": [
        ".chat-scrollable-area__message-container > div",
        "[data-a-target=\"side-nav-card\"]",
        ".vod-message"
      ]
    },
    {
      "id": "social-feed-optimizer",
      "hosts": ["tiktok.com", "instagram.com", "facebook.com", "bsky.app", "threads.net", "linkedin.com"],
      "paths": ["/*"],
      "behavior": "spa-feed-content-visibility",
      "feedSelectors": [
        "article",
        "[role=\"feed\"] > div",
        "[data-e2e=\"recommend-list-item-container\"]"
      ]
    },
    {
      "id": "fandom-wiki-optimizer",
      "hosts": ["fandom.com"],
      "paths": ["/*"],
      "behavior": "contain-heavy-containers",
      "deferSelectors": [
        ".top-ads-container",
        ".bottom-ads-container",
        ".right-rail-wrapper",
        "#WikiaBar",
        "aside.page__right-rail"
      ]
    },
    {
      "id": "ai-workspace-optimizer",
      "hosts": ["chatgpt.com", "claude.ai"],
      "paths": ["/*"],
      "behavior": "spa-feed-content-visibility",
      "feedSelectors": [
        "[data-testid^=\"conversation-turn-\"]",
        "article[data-turn-id]"
      ]
    }
  ]
}
